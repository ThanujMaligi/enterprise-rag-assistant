# Enterprise RAG System Configuration
APP_NAME="Enterprise RAG Knowledge Assistant"
LOG_LEVEL="INFO"

# API & Server Settings
FASTAPI_HOST="0.0.0.0"
FASTAPI_PORT=8000
STREAMLIT_PORT=8501

# LLM Configurations
# Options: "gemini", "openai", "local_huggingface", "mock"
LLM_PROVIDER="local_huggingface"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_MODEL_NAME="gemini-1.5-flash"

# Embedding Model
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DEVICE="cpu"

# Vector Store Configurations
DEFAULT_VECTOR_DB="faiss" # Options: "faiss", "chromadb"
CHROMA_PERSIST_DIR="./data/chroma_db"
FAISS_PERSIST_DIR="./data/faiss_db"

# RAG & Chunking Parameters
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
ENABLE_RERANKING=true
TOP_K_RETRIEVAL=5
TOP_K_RERANKED=3
